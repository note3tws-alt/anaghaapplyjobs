# Copy to .env and fill in. .env is gitignored. Never put the Indeed password here:
# Anagha signs in once herself in the dedicated browser profile (python -m jobbot login).

# Optional and PAID: Claude API key for AI-written summaries and cover letters (billed per use; not part of
# a Claude Pro subscription). Leave empty to use the free built-in templates.
# Without it the system uses its built-in templates (still tailored, never invented).
ANTHROPIC_API_KEY=
JOBBOT_AI_MODEL=claude-opus-5-5

# Optional: daily email report. Email stays OFF until EMAIL_ENABLED=true and all fields are set.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail use an App Password, not the account password.
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional: use a specific installed browser. "chrome" (default), "msedge", or "chromium".
JOBBOT_BROWSER_CHANNEL=chrome

# Optional: Telegram approvals. Create a bot with @BotFather, paste its token here, send /start to the bot,
# then run: python -m jobbot telegram-setup   (it fills in TELEGRAM_CHAT_ID). Only that chat is obeyed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
